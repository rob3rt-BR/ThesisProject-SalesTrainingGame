  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-UC-03
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 974d5408a3bbae64c81ed303c42bb2e6, type: 2}
  scenarioId: AI-UC-03
  scenarioContext: "Du betreust einen Kunden, der eine CRM-Software verwendet. Im
    Gespr\xE4ch wird deutlich, dass viele Daten noch manuell zwischen CRM und Marketing-System
    \xFCbertragen werden. Das Gespr\xE4ch f\xFChrt von Discovery und Personalisierung
    zu einer konkreten Cross-Selling-Empfehlung."
  customerPersona: "Name: Oliver Meier\nRolle: Marketing Director\nPers\xF6nlichkeit:
    L\xF6sungsorientiert, aber kritisch gegen\xFCber Angeboten, die nur aus einer
    Feature-Liste bestehen."
  openingMessage: "\u201EUnser gr\xF6\xDFtes Problem ist die manuelle Daten\xFCbertragung.
    Welche Erweiterung w\xFCrde uns dabei konkret helfen?\u201C"
  questionContexts:
  - questionId: UC-M03-Q01
    dialogueContext: "Reagiere auf die Antwort zur Discovery. Frage anschlie\xDFend,
      was eine Cross-Selling-Empfehlung besonders passend und relevant macht."
  - questionId: UC-M03-Q02
    dialogueContext: "Reagiere auf die Antwort zur Relevanz einer Empfehlung. Frage
      anschlie\xDFend, welches zus\xE4tzliche Angebot zu einer CRM-Software mit manueller
      Marketingdaten\xFCbertragung passen k\xF6nnte."
  - questionId: UC-M03-Q03
    dialogueContext: "Reagiere auf die Antwort zur Marketing-Automation-Integration.
      Frage anschlie\xDFend, was vor einem Premium-Tarif-Upsell gepr\xFCft werden
      sollte."
  - questionId: UC-M03-Q04
    dialogueContext: "Reagiere auf die Antwort zur Pr\xFCfung des konkreten Kundenproblems.
      Frage anschlie\xDFend, warum ein einzelnes Product Feature noch kein ausreichender
      Grund f\xFCr ein Upsell ist."
  - questionId: UC-M03-Q05
    dialogueContext: "Reagiere auf die Antwort zum Bezug zwischen Feature und Kundenziel.
      Frage anschlie\xDFend, ob eine Empfehlung m\xF6glichst viele irrelevante Features
      enthalten sollte"
  - questionId: UC-M03-Q06
    dialogueContext: "Reagiere auf die Antwort zur Begrenzung auf relevante Features.
      Frage anschlie\xDFend, ob ein Cross-Sell einen direkten Bezug zum bestehenden
      Produkt oder zur Kundensituation haben sollte."
  - questionId: UC-M03-Q07
    dialogueContext: "Reagiere auf die Antwort zum direkten Produktbezug. Stelle
      abschlie\xDFend eine kurze Frage dazu, wie Oliver eine gute Empfehlung von
      einer beliebigen Produktwerbung unterscheiden w\xFCrde."
