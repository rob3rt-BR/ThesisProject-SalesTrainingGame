  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: dcd6d4e5b89654f468dc085874c6d5e7, type: 2}
  scenarioId: AI-UC-04
  scenarioContext: "Du betreust einen Kunden, der mit dem aktuellen Tarif zufrieden
    ist. Ein Premium-Tarif k\xF6nnte einen wichtigen Reporting-Prozess verbessern,
    kostet aber deutlich mehr als der aktuelle Tarif."
  customerPersona: "Name: Stefan K\xF6nig\nRolle: Einkaufsleiter\nPers\xF6nlichkeit:
    Preisbewusst, erfahren und empfindlich gegen\xFCber manipulativen Verkaufstechniken."
  openingMessage: "\u201EDas Upgrade klingt interessant, aber der Preis ist deutlich
    h\xF6her. Warum sollte ich daf\xFCr mehr bezahlen?\u201C"
  questionContexts:
  - questionId: UC-M04-Q01
    dialogueContext: Stefan soll mit einer transparenten, permission-based Empfehlung
      angesprochen werden, nicht mit einer direkten Kaufaufforderung.
  - questionId: UC-M04-Q02
    dialogueContext: "Stefan \xE4u\xDFert eine konkrete Preis-Objection und erwartet
      eine sachliche Erkl\xE4rung statt eines Rabatts ohne Begr\xFCndung."
  - questionId: UC-M04-Q03
    dialogueContext: "Stefan m\xF6chte wissen, welche zus\xE4tzlichen Leistungen
      im h\xF6heren Preis enthalten sind."
  - questionId: UC-M04-Q04
    dialogueContext: "Stefan fragt, ob der bestehende Tarif weiterhin verf\xFCgbar
      bleibt, falls er sich gegen das Upgrade entscheidet."
  - questionId: UC-M04-Q05
    dialogueContext: "Stefan lehnt das Cross-Sell zun\xE4chst ab und beobachtet,
      ob der Sales-Mitarbeiter professionell reagiert."
  - questionId: UC-M04-Q06
    dialogueContext: "Stefan bemerkt, dass der Sales-Mitarbeiter k\xFCnstlichen Zeitdruck
      erzeugt."
  - questionId: UC-M04-Q07
    dialogueContext: "Stefan fragt nach dem konkreten Nutzen des Premium-Reportings
      f\xFCr seinen Einkaufsprozess."
