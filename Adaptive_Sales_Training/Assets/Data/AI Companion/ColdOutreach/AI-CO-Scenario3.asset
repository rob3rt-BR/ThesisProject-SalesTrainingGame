  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-Scenario3
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 752a52fbfd0ec3b44a914b584de12b12, type: 2}
  scenarioId: AI-CO-03
  scenarioContext: "Du kontaktierst einen Prospect f\xFCr eine Software zur Automatisierung
    von Reports. Die Ansprechpartnerin hat gerade ein neues Reporting-Team aufgebaut.
    Das Gespr\xE4ch behandelt den Aufbau einer kurzen ersten Nachricht: Er\xF6ffnung,
    Betreff, Call-to-Action, Kundennutzen und Personalisierung."
  customerPersona: "Name: Julia Neumann\nRolle: Head of Business Intelligence\nPers\xF6nlichkeit:
    Effizient, neugierig und wenig geduldig mit langen Produktpr\xE4sentationen."
  openingMessage: "\u201EIch habe nur kurz Zeit. K\xF6nnen Sie mir in einem Satz
    erkl\xE4ren, warum Sie anrufen?\u201C"
  questionContexts:
  - questionId: CO-M03-Q01
    dialogueContext: "Reagiere auf die Antwort zum Aufbau der ersten Gespr\xE4chssekunden.
      Frage anschlie\xDFend, wie ein passender Betreff f\xFCr eine Cold Email formuliert
      werden sollte."
  - questionId: CO-M03-Q02
    dialogueContext: "Reagiere auf die Antwort zum E-Mail-Betreff. Frage anschlie\xDFend,
      welchen kleinen und klaren n\xE4chsten Schritt die E-Mail vorschlagen k\xF6nnte."
  - questionId: CO-M03-Q03
    dialogueContext: "Reagiere auf die Antwort zum Call-to-Action. Frage anschlie\xDFend,
      ob eine erste Nachricht eher Produkt-Features oder konkrete Kundenvorteile
      hervorheben sollte."
  - questionId: CO-M03-Q04
    dialogueContext: "Reagiere auf die Antwort zum Kundennutzen. Frage anschlie\xDFend,
      wie dieser Nutzen mit der konkreten Situation des Prospects verbunden werden
      kann."
  - questionId: CO-M03-Q05
    dialogueContext: "Reagiere auf die Antwort zur Personalisierung. Frage anschlie\xDFend,
      ob ein Sales Script wortw\xF6rtlich vorgelesen werden sollte."
  - questionId: CO-M03-Q06
    dialogueContext: "Reagiere auf die Antwort zum flexiblen Einsatz eines Scripts.
      Frage anschlie\xDFend, wie viele Call-to-Actions eine klare erste Nachricht
      normalerweise enthalten sollte."
  - questionId: CO-M03-Q07
    dialogueContext: "Reagiere auf die Antwort zur Anzahl der Call-to-Actions. Stelle
      abschlie\xDFend eine kurze Frage dazu, wie eine gute erste Nachricht insgesamt
      auf den Prospect wirken sollte."
