  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-Scenario3
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 752a52fbfd0ec3b44a914b584de12b12, type: 2}
  scenarioId: AI-CO-03
  scenarioContext: "Du kontaktierst einen Prospect f\xFCr eine Software zur Automatisierung
    von Reports. Die Ansprechpartnerin hat gerade ein neues Reporting-Team aufgebaut.
    Deine Aufgabe ist es, eine kurze, relevante Er\xF6ffnung zu formulieren.\n"
  customerPersona: "Name: Julia Neumann\nRolle: Head of Business Intelligence\nPers\xF6nlichkeit:
    Effizient, neugierig und wenig geduldig mit langen Produktpr\xE4sentationen."
  openingMessage: "\u201EIch habe nur kurz Zeit. K\xF6nnen Sie mir in einem Satz
    erkl\xE4ren, warum Sie anrufen?\u201C"
  questionContexts:
  - questionId: CO-M03-Q01
    dialogueContext: "Julia erwartet eine klare Er\xF6ffnung und m\xF6chte keine
      Unternehmensgeschichte h\xF6ren."
  - questionId: CO-M03-Q02
    dialogueContext: "Julia fragt, warum der Betreff der E-Mail ihre aktuelle Reporting
      Initiative erw\xE4hnt."
  - questionId: CO-M03-Q03
    dialogueContext: "Julia signalisiert vorsichtiges Interesse, m\xF6chte aber keinen
      einst\xFCndigen Demo-Termin vereinbaren."
  - questionId: CO-M03-Q04
    dialogueContext: "Julia fragt nach dem konkreten Ergebnis, das die Software f\xFCr
      ihr Team erm\xF6glichen k\xF6nnte.\n"
  - questionId: CO-M03-Q05
    dialogueContext: "Julia pr\xFCft, ob die Nachricht wirklich auf ihr Unternehmen
      zugeschnitten wurde oder nur wie eine Massenmail klingt."
  - questionId: CO-M03-Q06
    dialogueContext: "Julia bemerkt, dass der Sales-Mitarbeiter mechanisch klingt,
      und fordert eine nat\xFCrlichere Antwort."
  - questionId: CO-M03-Q07
    dialogueContext: "Julia erh\xE4lt eine Nachricht mit drei verschiedenen Terminoptionen,
      einem Download und einem Kaufangebot und fragt, was sie zuerst tun soll."
