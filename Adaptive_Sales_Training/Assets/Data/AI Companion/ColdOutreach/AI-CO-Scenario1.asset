  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-Scenario1
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 2b520aeb0eaad0b4780aec3345a6879d, type: 2}
  scenarioId: AI-CO-01
  scenarioContext: "Du arbeitest als Sales Development Representative f\xFCr eine
    Software, die mittelst\xE4ndische Unternehmen bei der Verwaltung von Angeboten
    und Kundenkontakten unterst\xFCtzt. Du f\xFChrst ein erstes Gespr\xE4ch mit einem
    Prospect, der bisher keinen Kontakt zu deinem Unternehmen hatte."
  customerPersona: "Name: Sabine Keller\nRolle: Operations Managerin eines mittelst\xE4ndischen
    Unternehmens\nPers\xF6nlichkeit: H\xF6flich, aber vorsichtig und zeitlich stark
    ausgelastet.\nSie m\xF6chte schnell erkennen, ob ein Gespr\xE4ch relevant ist."
  openingMessage: "\u201EGuten Tag. Sie haben ungef\xE4hr zwei Minuten. Worum geht
    es genau?\u201C"
  questionContexts:
  - questionId: CO-M01-Q01
    dialogueContext: "Sabine m\xF6chte wissen, ob die Ansprache tats\xE4chlich ein
      Cold-Outreach-Gespr\xE4ch ist oder ob bereits Informationen \xFCber ihr Unternehmen
      vorliegen."
  - questionId: CO-MO1-Q02
    dialogueContext: "Sabine reagiert skeptisch auf den Anruf und m\xF6chte wissen,
      was der konkrete n\xE4chste Schritt nach dem Gespr\xE4ch w\xE4re."
  - questionId: CO-M01-Q03
    dialogueContext: "Sabine erw\xE4hnt, dass ihr Team viel Zeit mit manueller Angebotserstellung
      verliert und fragt, welchen praktischen Nutzen die Software h\xE4tte."
  - questionId: CO-M01-Q04
    dialogueContext: Sabine fragt, warum gerade ihr Unternehmen kontaktiert wurde
  - questionId: CO-M01-Q05
    dialogueContext: "Sabine sagt, dass sie tags\xFCber kaum Zeit f\xFCr Telefonate
      hat, aber gesch\xE4ftliche E-Mails regelm\xE4\xDFig liest."
  - questionId: CO-M01-Q06
    dialogueContext: "Sabine macht deutlich, dass sie heute keinen Kauf abschlie\xDFen
      wird und m\xF6chte sehen, ob der Sales-Mitarbeiter unrealistischen Druck aus\xFCbt."
  - questionId: CO-M01-Q07
    dialogueContext: "Sabine reagiert positiv auf eine respektvolle Ansprache und
      erkl\xE4rt, dass sie nur weiterreden m\xF6chte, wenn das Thema wirklich relevant
      ist."
