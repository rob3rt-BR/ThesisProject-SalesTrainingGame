  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-Scenario1
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 2b520aeb0eaad0b4780aec3345a6879d, type: 2}
  scenarioId: AI-CO-01
  scenarioContext: "Du arbeitest als Sales Development Representative f\xFCr eine
    Software, die mittelst\xE4ndische Unternehmen bei der Verwaltung von Angeboten
    und Kundenkontakten unterst\xFCtzt. Du f\xFChrst ein erstes Gespr\xE4ch mit einem
    Prospect, zu dem bisher keine Gesch\xE4ftsbeziehung besteht. Das Gespr\xE4ch
    soll schrittweise von der Bedeutung von Cold Outreach bis zu einem respektvollen
    n\xE4chsten Schritt f\xFChren."
  customerPersona: "Name: Sabine Keller\nRolle: Operations Managerin eines mittelst\xE4ndischen
    Unternehmens\nPers\xF6nlichkeit: H\xF6flich, aber vorsichtig und zeitlich stark
    ausgelastet.\nSie m\xF6chte schnell erkennen, ob ein Gespr\xE4ch relevant ist."
  openingMessage: "\u201EGuten Tag. Sie haben ungef\xE4hr zwei Minuten. Worum geht
    es genau?\u201C"
  questionContexts:
  - questionId: CO-M01-Q01
    dialogueContext: "Reagiere auf die Antwort des Teilnehmers zur Bedeutung von
      Cold Outreach. Frage anschlie\xDFend als Kunde, welches Ziel ein solcher Erstkontakt
      normalerweise verfolgt."
  - questionId: CO-MO1-Q02
    dialogueContext: "Reagiere auf die Antwort zur Zielsetzung des ersten Kontakts.
      Frage anschlie\xDFend, wie der m\xF6gliche Nutzen f\xFCr den Kunden in einer
      kurzen Value Proposition formuliert werden k\xF6nnte."
  - questionId: CO-M01-Q03
    dialogueContext: "Reagiere auf die Erkl\xE4rung der Value Proposition. Frage
      anschlie\xDFend, woran der Prospect erkennen kann, dass dieser Nutzen speziell
      f\xFCr sein Unternehmen relevant ist."
  - questionId: CO-M01-Q04
    dialogueContext: "Reagiere auf die Antwort zur Relevanz der Ansprache. Frage
      anschlie\xDFend, welcher Kommunikationskanal f\xFCr diesen Kontakt geeignet
      w\xE4re und warum."
  - questionId: CO-M01-Q05
    dialogueContext: "Reagiere auf die Antwort zur Auswahl des Kommunikationskanals.
      Frage anschlie\xDFend, ob Cold Outreach normalerweise schon beim ersten Kontakt
      zu einem abgeschlossenen Kauf f\xFChren sollte."
  - questionId: CO-M01-Q06
    dialogueContext: "Reagiere auf die Antwort zur direkten Kaufentscheidung. Frage
      anschlie\xDFend, wie der Sales-Mitarbeiter verhindern kann, dass die Ansprache
      aufdringlich wirkt."
  - questionId: CO-M01-Q07
    dialogueContext: "Reagiere auf die Antwort zu Respekt und Relevanz. Stelle abschlie\xDFend
      eine kurze Frage dazu, wie ein sinnvoller und respektvoller n\xE4chster Schritt
      aussehen k\xF6nnte."
