  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-Scenario5
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 66ba2efa598cd6e46bd4391e9bd31a25, type: 2}
  scenarioId: AI-CO-05
  scenarioContext: "Du hast einem Prospect bereits eine erste E-Mail geschickt und
    einmal angerufen. Der Prospect hat bisher nicht geantwortet. Das Gespr\xE4ch
    behandelt Sales Cadence, relevante Metriken, Follow-up, \xDCbergabe, Persistence
    und CRM-Dokumentation."
  customerPersona: "Name: Daniel Hoffmann\nRolle: Gesch\xE4ftsf\xFChrer eines kleinen
    Softwareunternehmens\nPers\xF6nlichkeit: Sehr besch\xE4ftigt. Er reagiert positiv
    auf kurze, relevante Nachrichten, aber negativ auf wiederholten Druck."
  openingMessage: "\u201EIch sehe, dass Sie bereits mehrmals versucht haben, mich
    zu erreichen. Was ist jetzt anders?\u201C"
  questionContexts:
  - questionId: CO-M05-Q01
    dialogueContext: "Reagiere auf die Antwort zur Sales Cadence. Frage anschlie\xDFend,
      anhand welcher Kennzahlen die Qualit\xE4t einer Outreach-Strategie beurteilt
      werden k\xF6nnte."
  - questionId: CO-M05-Q02
    dialogueContext: "Reagiere auf die Antwort zu qualifizierten Meetings und sinnvollen
      Gespr\xE4chen. Frage anschlie\xDFend, wie ein Follow-up aussehen sollte, wenn
      ein Prospect nicht antwortet."
  - questionId: CO-M05-Q03
    dialogueContext: "Reagiere auf die Antwort zum relevanten Follow-up. Frage anschlie\xDFend,
      welche Informationen bei einer \xDCbergabe an einen Account Executive wichtig
      w\xE4ren."
  - questionId: CO-M05-Q04
    dialogueContext: "Reagiere auf die Antwort zur \xDCbergabe eines Prospects. Frage
      anschlie\xDFend, wie die Wirksamkeit von Cold Outreach umfassend bewertet werden
      sollte."
  - questionId: CO-M05-Q05
    dialogueContext: "Reagiere auf die Antwort zur Bewertung anhand mehrerer Kennzahlen.
      Frage anschlie\xDFend, ob Persistence bedeutet, einen Prospect unbegrenzt weiter
      zu kontaktieren."
  - questionId: CO-M05-Q06
    dialogueContext: "Reagiere auf die Antwort zur angemessenen Begrenzung von Persistence.
      Frage anschlie\xDFend, warum die Ergebnisse der Kontaktversuche im CRM dokumentiert
      werden sollten."
  - questionId: CO-M05-Q07
    dialogueContext: "Reagiere auf die Antwort zur CRM-Dokumentation. Stelle abschlie\xDFend
      eine kurze Frage dazu, wie eine professionelle Outreach-Strategie insgesamt
      wirken sollte."
