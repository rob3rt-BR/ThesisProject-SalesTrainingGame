  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-Scenario5
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 66ba2efa598cd6e46bd4391e9bd31a25, type: 2}
  scenarioId: AI-CO-05
  scenarioContext: "Du hast einem Prospect bereits eine erste E-Mail geschickt und
    einmal angerufen. Der Prospect hat bisher nicht geantwortet. Du planst einen
    letzten kurzen Follow-up mit einem hilfreichen Hinweis und einer klaren M\xF6glichkeit,
    die Kommunikation zu beenden."
  customerPersona: "Name: Daniel Hoffmann\nRolle: Gesch\xE4ftsf\xFChrer eines kleinen
    Softwareunternehmens\nPers\xF6nlichkeit: Sehr besch\xE4ftigt. Er reagiert positiv
    auf kurze, relevante Nachrichten, aber negativ auf wiederholten Druck."
  openingMessage: "\u201EIch sehe, dass Sie bereits mehrmals versucht haben, mich
    zu erreichen. Was ist jetzt anders?\u201C"
  questionContexts:
  - questionId: CO-M05-Q01
    dialogueContext: "Daniel fragt, warum der Sales-Mitarbeiter mehrere Kontaktversuche
      \xFCber verschiedene Kan\xE4le plant."
  - questionId: CO-M05-Q02
    dialogueContext: "Daniel m\xF6chte wissen, woran der Sales-Mitarbeiter den Erfolg
      der Kontaktstrategie messen w\xFCrde."
  - questionId: CO-M05-Q03
    dialogueContext: "Daniel hat bisher nicht geantwortet und fragt, welchen zus\xE4tzlichen
      Nutzen die neue Nachricht bietet."
  - questionId: CO-M05-Q04
    dialogueContext: "Daniel stimmt einem Gespr\xE4ch mit einem Account Executive
      zu und m\xF6chte wissen, welche Informationen weitergegeben werden."
  - questionId: CO-M05-Q05
    dialogueContext: "Daniel fragt, ob viele Aktivit\xE4ten automatisch bedeuten,
      dass die Outreach-Strategie erfolgreich war."
  - questionId: CO-M05-Q06
    dialogueContext: "Daniel macht deutlich, dass weitere Nachrichten ohne neue Relevanz
      als st\xF6rend empfunden w\xFCrden."
  - questionId: CO-M05-Q07
    dialogueContext: "Daniel m\xF6chte sicherstellen, dass die Gespr\xE4chsinformationen
      bei einer \xDCbergabe nicht verloren gehen."
