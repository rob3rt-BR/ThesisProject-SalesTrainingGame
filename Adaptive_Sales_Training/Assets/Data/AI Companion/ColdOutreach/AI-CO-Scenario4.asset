  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-Scenario4
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: da6e65ccdd83e7c4da09abeb5258144f, type: 2}
  scenarioId: AI-CO-04
  scenarioContext: "Du sprichst mit einem Prospect, dessen Team aktuell mit mehreren
    Tabellen arbeitet. Der Prospect hat jedoch gerade erkl\xE4rt, dass kein Budget
    eingeplant ist. Du sollst die Situation verstehen, ohne Druck auszu\xFCben."
  customerPersona: "Name: Thomas Richter\nRolle: Finance Manager\nPers\xF6nlichkeit:
    Skeptisch, aber gespr\xE4chsbereit, wenn seine Bedenken ernst genommen werden."
  openingMessage: "\u201EWir haben daf\xFCr kein Budget. Ich glaube nicht, dass dieses
    Gespr\xE4ch etwas bringt.\u201C"
  questionContexts:
  - questionId: CO-M04-Q01
    dialogueContext: "Thomas fragt, wie der Sales-Mitarbeiter mehr \xFCber den aktuellen
      Prozess erfahren m\xF6chte."
  - questionId: CO-M04-Q02
    dialogueContext: "Thomas hat kein Budget in diesem Quartal, k\xF6nnte aber im
      n\xE4chsten Planungszeitraum eine neue L\xF6sung pr\xFCfen."
  - questionId: CO-M04-Q03
    dialogueContext: "Thomas erkl\xE4rt, dass fr\xFChere Sales-Mitarbeiter seine
      Aussagen oft ignoriert und sofort weiter argumentiert haben."
  - questionId: CO-M04-Q04
    dialogueContext: "Thomas ist nicht der finale Entscheider und fragt, wie der
      Sales Mitarbeiter mit der Assistenz der Gesch\xE4ftsf\xFChrung umgehen w\xFCrde."
  - questionId: CO-M04-Q05
    dialogueContext: "Thomas stimmt einem Folgetermin zu, m\xF6chte aber sicherstellen,
      dass seine wichtigsten Pain Points weitergegeben werden."
  - questionId: CO-M04-Q06
    dialogueContext: Thomas nennt fehlendes Budget als Objection, deutet aber gleichzeitig
      auf hohe manuelle Kosten im aktuellen Prozess hin.
  - questionId: CO-M04-Q07
    dialogueContext: Thomas reagiert negativ auf einen langen Product Pitch und fordert,
      dass zuerst seine Situation verstanden wird.
