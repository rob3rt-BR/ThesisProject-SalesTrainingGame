  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-02
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: 5a40a77c91919994cb4258e2fe430890, type: 2}
  scenarioId: AI-CO-02
  scenarioContext: "Du verkaufst eine SaaS-L\xF6sung f\xFCr interne Prozesse und
    Kundenverwaltung. Der Prospect ist ein wachsendes Unternehmen, das k\xFCrzlich
    drei neue Niederlassungen er\xF6ffnet hat. Das Gespr\xE4ch f\xFChrt von der Auswahl
    des passenden Kundentyps \xFCber Research und Ansprechpartner bis zur Dokumentation
    im CRM."
  customerPersona: "Name: Markus Vogel\nRolle: Leiter des Customer Operations Teams\nPers\xF6nlichkeit:
    Analytisch und direkt. Er reagiert positiv auf konkrete Informationen, lehnt
    aber oberfl\xE4chliche Personalisierung ab.\n"
  openingMessage: "\u201ESie erw\xE4hnen unser Wachstum in Ihrer Nachricht. Was genau
    hat das mit Ihrer Software zu tun?\u201C"
  questionContexts:
  - questionId: CO-M02-Q01
    dialogueContext: "Reagiere auf die Antwort zur Bedeutung eines Ideal Customer
      Profile. Frage anschlie\xDFend, welche aktuelle Unternehmensentwicklung als
      relevanter Anlass f\xFCr Cold Outreach dienen k\xF6nnte."
  - questionId: CO-M02-Q02
    dialogueContext: "Reagiere auf die Antwort zu Trigger Events. Frage anschlie\xDFend,
      welche Person im Unternehmen f\xFCr das angesprochene Problem besonders relevant
      sein k\xF6nnte."
  - questionId: CO-M02-Q03
    dialogueContext: "Reagiere auf die Antwort zur Rolle des passenden Ansprechpartners.
      Frage anschlie\xDFend, welche Unternehmensinformationen vor der Kontaktaufnahme
      recherchiert werden sollten."
  - questionId: CO-M02-Q04
    dialogueContext: "Reagiere auf die Antwort zu sinnvoller Recherche. Frage anschlie\xDFend,
      wo diese Erkenntnisse dokumentiert werden sollten, damit sie f\xFCr weitere
      Kontaktversuche verf\xFCgbar bleiben."
  - questionId: CO-M02-Q05
    dialogueContext: "Reagiere auf die Antwort zur CRM-Dokumentation. Frage anschlie\xDFend,
      ob ein dokumentiertes Trigger Event als Gespr\xE4chsanlass verwendet werden
      kann."
  - questionId: CO-M02-Q06
    dialogueContext: "Reagiere auf die Antwort zur Bedeutung eines Trigger Events.
      Frage anschlie\xDFend, ob das Sammeln m\xF6glichst vieler privater Informationen
      eine bessere Personalisierung erzeugt."
  - questionId: CO-M02-Q07
    dialogueContext: "Reagiere auf die Antwort zu privaten und relevanten Informationen.
      Stelle abschlie\xDFend eine kurze Frage dazu, welche Informationen f\xFCr eine
      respektvolle Personalisierung wirklich ausreichen."
