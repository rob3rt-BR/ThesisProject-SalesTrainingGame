  m_Script: {fileID: 11500000, guid: 4549cc761c8952748aed4c13489b9771, type: 3}
  m_Name: AI-CO-04
  m_EditorClassIdentifier: Assembly-CSharp::AIDialogueScenario
  module: {fileID: 11400000, guid: da6e65ccdd83e7c4da09abeb5258144f, type: 2}
  scenarioId: AI-CO-04
  scenarioContext: "Du sprichst mit einem Prospect, dessen Team aktuell mit mehreren
    Tabellen arbeitet. Der Prospect hat jedoch erkl\xE4rt, dass momentan kein Budget
    eingeplant ist. Das Gespr\xE4ch behandelt Discovery-Fragen, aktives Zuh\xF6ren,
    den Umgang mit Objections und die \xDCbergabe eines qualifizierten Prospects."
  customerPersona: "Name: Thomas Richter\nRolle: Finance Manager\nPers\xF6nlichkeit:
    Skeptisch, aber gespr\xE4chsbereit, wenn seine Bedenken ernst genommen werden."
  openingMessage: "\u201EWir haben daf\xFCr kein Budget. Ich glaube nicht, dass dieses
    Gespr\xE4ch etwas bringt.\u201C"
  questionContexts:
  - questionId: CO-M04-Q01
    dialogueContext: "Reagiere auf die Antwort zur offenen Discovery-Frage. Frage
      anschlie\xDFend, wie der Sales-Mitarbeiter mit der Aussage \u201EDaf\xFCr haben
      wir momentan kein Budget\u201C umgehen sollte."
  - questionId: CO-M04-Q02
    dialogueContext: "Reagiere auf die Antwort zur Budget-Objection. Frage anschlie\xDFend,
      woran Thomas erkennen w\xFCrde, dass seine Aussage wirklich aufmerksam aufgenommen
      wurde."
  - questionId: CO-M04-Q03
    dialogueContext: "Reagiere auf die Antwort zum aktiven Zuh\xF6ren. Frage anschlie\xDFend,
      wie der Sales-Mitarbeiter mit einer Assistenz oder einem Gatekeeper umgehen
      sollte."
  - questionId: CO-M04-Q04
    dialogueContext: "Reagiere auf die Antwort zum respektvollen Umgang mit dem Gatekeeper.
      Frage anschlie\xDFend, welche Informationen nach einem erfolgreichen Cold Call
      f\xFCr die weitere Bearbeitung dokumentiert werden sollten."
  - questionId: CO-M04-Q05
    dialogueContext: "Reagiere auf die Antwort zur \xDCbergabe relevanter Informationen.
      Frage anschlie\xDFend, ob Objections im Cold Outreach als normale Gespr\xE4chs-reaktionen
      betrachtet werden k\xF6nnen."
  - questionId: CO-M04-Q06
    dialogueContext: "Reagiere auf die Antwort zum Umgang mit Objections. Frage anschlie\xDFend,
      ob ein Cold Call grunds\xE4tzlich aus einem langen, einseitigen Product Pitch
      bestehen sollte."
  - questionId: CO-M04-Q07
    dialogueContext: "Reagiere auf die Antwort zum Product Pitch. Stelle abschlie\xDFend
      eine kurze Frage dazu, worauf der Sales-Mitarbeiter stattdessen den Schwerpunkt
      legen sollte."
