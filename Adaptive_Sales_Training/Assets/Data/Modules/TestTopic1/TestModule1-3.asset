  moduleId: TM_001
  moduleTitle: Testament
  moduleText: 'Testament debuted in 1987 with their album The Legacy. Their heaviest
    album is The New Order from the year 1988. Their most popular modern album is
    The Brotherhood of the Snake. Original members: Chuck Billy (Vocals), Alex Skolnic
    (Lead Guitar), Eric Peterson (Rythm Guitar).'
  questions:
  - questionId: Q_001
    questionText: What is Testament's heaviest album?
    answerOptions:
    - The Legacy
    - The New Order
    - Souls of Black
    - Brotherhood
    correctAnswerIndex: 1
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: Q_002
    questionText: Is Testament one of the big four of thrash metal?
    answerOptions:
    - True
    - False
    correctAnswerIndex: 1
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: Q_003
    questionText: In what year did Testament debut?
