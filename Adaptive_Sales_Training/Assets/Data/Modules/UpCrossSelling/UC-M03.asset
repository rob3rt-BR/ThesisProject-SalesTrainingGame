%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14a60cf4d7d773c46800f4a709ac8f92, type: 3}
  m_Name: UC-M03
  m_EditorClassIdentifier: Assembly-CSharp::MicroModule
  moduleId: UC-M03
  moduleTitle: Bedarf verstehen
  moduleText: "Gute Zusatzangebote beginnen mit Discovery. Der Sales-Mitarbeiter
    sollte verstehen, welche Ziele der Kunde verfolgt, welche Probleme aktuell bestehen
    und wie das bestehende Produkt verwendet wird.\nEine personalisierte Empfehlung
    verbindet diese Informationen mit einem konkreten Angebot. Bei Software k\xF6nnen
    beispielsweise zus\xE4tzliche Nutzer, erweiterte Analytics, Automatisierungen
    oder Integrationen sinnvoll sein. In einem allgemeinen Sales-Kontext k\xF6nnen
    passende Zubeh\xF6rprodukte oder erg\xE4nzende Services angeboten werden.\nNicht
    jedes verwandte Produkt ist automatisch ein gutes Cross-Sell. Relevanz, Kompatibilit\xE4t,
    Timing und der erwartete Kundennutzen sollten vor der Empfehlung gepr\xFCft werden."
  questions:
  - questionId: UC-M03-Q01
    questionText: "Welche Frage unterst\xFCtzt eine gute Discovery vor einem Cross-Sell?"
    answerOptions:
    - "\u201EM\xF6chten Sie noch etwas kaufen?\u201C"
    - "\u201EWelche Ziele m\xF6chten Sie mit Ihrer aktuellen L\xF6sung in den n\xE4chsten
      Monaten erreichen?\u201C"
    - "\u201EWarum haben Sie unser teuerstes Produkt noch nicht gekauft?\u201C"
    - "\u201EKann ich Ihnen sofort drei weitere Produkte nennen?\u201C"
    correctAnswerIndex: 1
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: UC-M03-Q02
    questionText: Was macht eine Cross-Selling-Empfehlung besonders passend?
    answerOptions:
    - Sie ist mit dem bestehenden Produkt und dem aktuellen Kundenbedarf verbunden
    - Sie ist das neueste Produkt des Anbieters
    - "Sie hat die h\xF6chste Gewinnmarge"
    - Sie wird jedem Kunden identisch angeboten
    correctAnswerIndex: 0
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: UC-M03-Q03
    questionText: "Ein Kunde nutzt eine CRM-Software und m\xF6chte seine Marketingdaten
      automatisch \xFCbertragen. Welches Angebot k\xF6nnte relevant sein?"
    answerOptions:
    - "Eine nicht verbundene B\xFCroeinrichtung"
    - Eine passende Marketing-Automation-Integration
    - Ein komplett anderes Produkt ohne Bezug
    - "Eine zweite CRM-Software ohne zus\xE4tzlichen Nutzen"
    correctAnswerIndex: 1
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: UC-M03-Q04
    questionText: "Was sollte vor der Empfehlung eines Premium-Tarifs gepr\xFCft
      werden?"
    answerOptions:
    - Ob der Sales-Mitarbeiter das Produkt besonders gerne verkauft
    - "Ob die zus\xE4tzlichen Funktionen ein konkretes Kundenproblem l\xF6sen"
    - "Ob der Kunde m\xF6glichst wenig Informationen erh\xE4lt"
    - "Ob der Tarif unabh\xE4ngig vom Bedarf teurer ist"
    correctAnswerIndex: 1
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: UC-M03-Q05
    questionText: "Warum ist ein Product Feature allein noch kein ausreichender Grund
      f\xFCr ein Upsell?"
    answerOptions:
    - "Weil Features niemals erkl\xE4rt werden d\xFCrfen"
    - Weil der Bezug zum Kundenziel und zum erwarteten Nutzen fehlt
    - Weil Kunden keine Premium-Produkte kaufen
    - "Weil ein Upsell ausschlie\xDFlich vom Preis abh\xE4ngt"
    correctAnswerIndex: 1
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: UC-M03-Q06
    questionText: "Eine Empfehlung sollte m\xF6glichst viele Features enthalten,
      auch wenn sie f\xFCr den Kunden nicht relevant sind"
    answerOptions:
    - Richtig
    - Falsch
    correctAnswerIndex: 1
    timeLimitSeconds: 20
    basePoints: 80
    speedBonusPoints: 40
  - questionId: UC-M03-Q07
    questionText: Ein Cross-Sell sollte einen nachvollziehbaren Bezug zum bestehenden
      Kauf oder zur Situation des Kunden haben
    answerOptions:
    - Richtig
    - Falsch
    correctAnswerIndex: 0
    timeLimitSeconds: 20
    basePoints: 80
    speedBonusPoints: 40
