    speedBonusPoints: 50
  - questionId: Q_003
    questionText: What is Trivium's second heaviest album?
    answerOptions:
    - Ascendancy
    - In Waves
    - The Sin and the Sentence
    - Shogun
    correctAnswerIndex: 3
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
