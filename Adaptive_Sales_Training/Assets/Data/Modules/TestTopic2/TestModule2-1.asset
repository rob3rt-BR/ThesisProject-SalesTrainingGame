    questionText: From what country are Parkway Drive?
    answerOptions:
    - Japan
    - England
    - USA
    - Australia
    correctAnswerIndex: 3
    timeLimitSeconds: 30
    basePoints: 100
    speedBonusPoints: 50
  - questionId: Q_002
    questionText: In what song does the singer get lifted on to a high platform?
    answerOptions:
